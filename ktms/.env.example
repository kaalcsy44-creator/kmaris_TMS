# KTMS Environment Variables
# Copy this file to .env and fill in the values

# Database (default: SQLite in ./data/ktms.db)
DATABASE_URL=sqlite:///./data/ktms.db

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sales@k-maris.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=K-MARIS Energy & Solutions <sales@k-maris.com>

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# Company prefix for document numbers
COMPANY_PREFIX=KMS

# Google Sheets sync (tracking_gas.js 연동)
# 스프레드시트 ID: URL의 /d/XXXX/ 부분
GOOGLE_SHEET_ID=1YwpCt1jJNkQVpng2q2B9CmwvaksCxkXpadIuAVyXWmk
# 서비스 계정 키 파일 경로 (둘 중 하나만 설정)
GOOGLE_SA_KEY_FILE=./config/google_sa_key.json
# 또는 JSON 내용 전체를 한 줄 문자열로 (Streamlit Cloud 등 파일 사용 불가 환경)
# GOOGLE_SA_KEY_JSON={"type":"service_account","project_id":"...","private_key_id":"...",...}

# Google 공유 드라이브 연동 (services/drive_svc.py)
# 키: 서비스 계정 ktms-drive@ktms-drive-514106 — 공유 드라이브 K-MARIS PROJECTS 의 콘텐츠 관리자.
# 로컬은 ktms/config/ktms_drive_sa.json 이 있으면 따로 설정하지 않아도 읽는다.
# DRIVE_SA_KEY_FILE=./config/ktms_drive_sa.json
# DRIVE_SA_KEY_JSON={"type":"service_account",...}      # Render 는 이것(키 내용 전체)
DRIVE_PARTS_ROOT_ID=1Iy5r6y8tdYjFFtTF0lbT58JV0WOD6tRf     # 00 ★PROJECT_PARTS
DRIVE_SERVICE_ROOT_ID=1nSXCAWgyhd_MnOSUiqc6GYz6OZTSNq_X   # 00 ★PROJECT_SERVICE
